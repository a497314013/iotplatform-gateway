[Unit]
Description=IOTPlatform Gateway
After=multi-user.target
ConditionPathExists=/etc/iotplatform-gateway/config/tb_gateway.json

[Service]
Type=simple
User=iotplatform_gateway
Group=iotplatform_gateway

WorkingDirectory=/var/lib/iotplatform_gateway
ExecStart=/var/lib/iotplatform_gateway/venv/bin/python3 -c "from iotplatform_gateway.tb_gateway import daemon; daemon()"
ExecStop=/bin/kill -INT $MAINPID
ExecReload=/bin/kill -TERM $MAINPID

Restart=on-failure

[Install]
WantedBy=multi-user.target
